package app

import (
	"github.com/emersonjoe/trilha"
	"github.com/emersonjoe/trilha/h"
	"github.com/emersonjoe/trilha/ui"
)

// Page renders GET /.
func Page(c *trilha.Ctx) (h.Node, error) {
	c.SetTitle("{{.T.home}}")
	return ui.Stack(
		ui.H1(h.Text("{{.T.hello}}{{.Name}}!")),
		ui.Lead(h.Text("{{.T.edit}}")),
		ui.Grid(
			ui.Card(
				ui.CardHeader(ui.CardTitle("{{.T.routes}}"), ui.CardDescription("{{.T.routes_desc}}")),
				ui.CardContent(h.P(h.Text("{{.T.routes_body}}"))),
				ui.CardFooter(ui.ButtonLink("/api/hello", ui.Outline(), h.Text("{{.T.see_hello}}"), ui.Icon("arrow-right"))),
			),
			ui.Card(
				ui.CardHeader(ui.CardTitle("{{.T.ui}}"), ui.CardDescription("{{.T.ui_desc}}")),
				ui.CardContent(ui.Field("name", "{{.T.your_name}}", ui.Input(h.ID("name"), h.Name("name"), h.Placeholder("Ada")), ui.Help("{{.T.ui_help}}"))),
				ui.CardFooter(ui.Button(h.Text("{{.T.primary}}")), ui.Button(ui.Secondary(), h.Text("{{.T.secondary}}")), ui.Badge(h.Text("{{.T.new}}"))),
			),
		),
	), nil
}

package app

import (
	"strings"

	"github.com/emersonjoe/trilha"

	"{{.Module}}/internal/session"
)

// public is what answers without a session. Everything else — every page,
// every route, the ones written tomorrow included — needs a login, because
// this middleware is at the root of app/ and is inherited by the whole tree.
var public = []string{"/login"}

// Middleware requires a session. Hiding a link in the menu is cosmetics; this
// is what actually keeps somebody out.
func Middleware(c *trilha.Ctx, next trilha.Next) error {
	path := c.Request().URL.Path
	for _, p := range public {
		if path == p || strings.HasPrefix(path, p+"/") {
			return next()
		}
	}
	return session.Flow.Require()(c, next)
}

// Package sessiontest opens a session in a test.
//
// It is a package of its own, and not a file in internal/session, because it
// imports testing: a helper that drags the testing package into the binary is
// a helper that costs something in production.
package sessiontest

import (
	"net/http"
	"net/url"
	"testing"

	"github.com/emersonjoe/trilha"
)

// Login signs in as the seeded account, which is what a test of a screen
// behind app/middleware.go needs before its first request.
//
//	c := trilha.NewTestClient(t, newApp())
//	sessiontest.Login(t, c)
//
// It posts to the login screen instead of building a session by hand: what it
// proves along the way is that the login still works, and a helper that forged
// a cookie would keep passing after the login stopped.
func Login(t *testing.T, c *trilha.TestClient) {
	t.Helper()
	rec := c.PostForm("/login", url.Values{
		"email":    {"{{.T.app_seed_email}}"},
		"password": {"{{.T.app_seed_password}}"},
	})
	if rec.Code != http.StatusSeeOther {
		t.Fatalf("sessiontest: the seeded login answered %d, not a redirect", rec.Code)
	}
}

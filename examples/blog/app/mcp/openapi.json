{
  "openapi": "3.1.0",
  "info": {
    "title": "blog",
    "version": "0.0.0"
  },
  "paths": {
    "/.well-known/security.txt": {
      "get": {
        "tags": [
          "security.txt"
        ],
        "summary": "GET serve a security.txt da RFC 9116, com validade de um ano.",
        "operationId": "getWellKnownSecurityTxt",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/anexos/{nome}": {
      "parameters": [
        {
          "name": "nome",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "anexos"
        ],
        "summary": "GET manda o anexo.",
        "description": "O nome que vai no Content-Disposition é o que o c.File\nsaneou na entrada, e o tipo é o que ele leu no conteúdo — nenhum dos dois é\no que o navegador disse na hora do upload.",
        "operationId": "getAnexosNome",
        "parameters": [
          {
            "name": "ver",
            "in": "query",
            "description": "qualquer valor abre no visor em vez de baixar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": [
          "posts"
        ],
        "summary": "GET lists posts.",
        "description": "Every /api route goes through the rate limit in app/api/middleware.go, and\na middleware is not something the generator can read: that 429 is only in\nthe document because this line puts it there.",
        "operationId": "getApiPosts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/posts.Post"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "posts"
        ],
        "summary": "POST creates a post from JSON {\"title\": \"...\", \"body\": \"...\"}.",
        "operationId": "postApiPosts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/posts.Post"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "posts"
        ],
        "summary": "GET returns one post by slug.",
        "operationId": "getApiPostsId",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/posts.Post"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "posts"
        ],
        "summary": "DELETE removes a post.",
        "operationId": "deleteApiPostsId",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/blog/novo/rascunho": {
      "post": {
        "tags": [
          "rascunho"
        ],
        "summary": "POST takes the draft the island sends.",
        "description": "It is a route.go, so it is an API\nroute: CSRF applies, and the token the island carries is the one c.Island\nwrote into the element.",
        "operationId": "postBlogNovoRascunho",
        "responses": {
          "200": {
            "description": "OK"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/documentos/planilha": {
      "get": {
        "tags": [
          "planilha"
        ],
        "summary": "GET /documentos/planilha baixa a lista inteira.",
        "operationId": "getDocumentosPlanilha",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "planilha"
        ],
        "summary": "POST recebe a planilha editada.",
        "description": "Arquivo ilegível é uma mensagem no campo;\ncélula inválida é uma lista de linha e coluna, que é o que a pessoa precisa\npara achar o erro numa planilha de quatro mil linhas.",
        "operationId": "postDocumentosPlanilha",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/legado/apagar": {
      "post": {
        "tags": [
          "apagar"
        ],
        "summary": "POST answers the delete button of /legado.",
        "operationId": "postLegadoApagar",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": [
          "mcp"
        ],
        "summary": "POST is the Streamable HTTP endpoint.",
        "description": "The server is built once in\napp/setup.go from the routes of this app and the OpenAPI document next to\nthis file; here it only answers.",
        "operationId": "postMcp",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/tarefas/tentar": {
      "post": {
        "tags": [
          "tentar"
        ],
        "summary": "POST runs the task again and goes to the new run's screen.",
        "operationId": "postTarefasTentar",
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details, the body of every API error.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "description": "One message per field, when the body failed validation.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "status",
          "title"
        ]
      },
      "posts.Post": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  }
}
